    "tsx": "^4.21.0",
    "@google/generative-ai": "^0.24.1",
    "@repo/db": "*",
    "@types/cookie-parser": "^1.4.10",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",

# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and should never be committed.

NEXT_PUBLIC_AUTH_SERVICE_URL=http://localhost:4000
NEXT_PUBLIC_PLANNER_SERVICE_URL=http://localhost:4001
NEXT_PUBLIC_ANALYTICS_SERVICE_URL=http://localhost:4003
NEXT_PUBLIC_HABIT_SERVICE_URL=http://localhost:4002

# Server-only habit service URL (not exposed to the browser).
# Used by RSC dashboard prefetch. Can point to the internal Docker network
# hostname (e.g. http://habit-service:4002) for lower latency in production.
# Falls back to NEXT_PUBLIC_HABIT_SERVICE_URL when not set.
HABIT_SERVICE_URL=http://localhost:4002

# WhatsApp Bot (displayed in Settings for pairing)
NEXT_PUBLIC_WHATSAPP_BOT_NUMBER=

# Push Notifications — get from your VAPID key pair generator
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BPcaksYqPqkxBKtYMjp6hcjjkDM3zo0jEl27rmSUFC2xmeO_kPnfCnbtO6Gz_7fx15pG84qlusvOQN8MmlN8dGE

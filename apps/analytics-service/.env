# ─── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4003

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:12345@localhost:5432/transition

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SEC=secretkey123

# ─── Frontend ────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

# ─── Queue ───────────────────────────────────────────────────────────────────
QUEUE_ENABLED=false

# ─── Internal Secrets ────────────────────────────────────────────────────────
ANALYTICS_INTERNAL_SECRET=transition-analytics-internal-secret
# habit-service calls: analytics-service verifies with HABIT_INTERNAL_SECRET first
HABIT_INTERNAL_SECRET=transition-habit-internal-secret

# ─── Service URLs ────────────────────────────────────────────────────────────
HABIT_SERVICE_URL=http://localhost:4002

# ─── Export ──────────────────────────────────────────────────────────────────
EXPORT_DIR=/tmp/exports
EXPORT_CONCURRENCY=3
# In production, set this to your CDN base URL for exported file links
CDN_BASE_URL=https://cdn.example.com

# ─── WhatsApp Activity / Debounce ────────────────────────────────────────────
WHATSAPP_ACTIVITY_CANCEL_DEBOUNCE_MS=60000

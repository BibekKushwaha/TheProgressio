// This is the Auth Service's own Prisma schema (Database-per-Service pattern).
// It only contains models owned by the Auth domain.
// Other services reference userId as an opaque string — no foreign keys across service boundaries.

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String     @id @default(uuid())
  username         String     @unique
  email            String     @unique
  password         String
  dailyGoalHours   Float      @default(4.0)
  createdAt        DateTime   @default(now())
}

PORT=4000
JWT_SEC=your_jwt_secret_here
DATABASE_URL=postgresql://postgres:password@localhost:5432/yourdb
FRONTEND_URL=http://localhost:3000

# Set true only if you have Redis running (enables BullMQ job queue)
QUEUE_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Email (Resend SMTP) ───────────────────────────────────────────────────────
# Sign up at https://resend.com, create an API key, paste it as SMTP_PASS
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_YOUR_API_KEY_HERE
FROM_EMAIL=onboarding@resend.dev

# ─── Google OAuth (optional) ──────────────────────────────────────────────────
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=
GOOGLE_WEB_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

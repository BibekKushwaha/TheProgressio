# ─── Core ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4002

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:12345@localhost:5432/transition

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SEC=secretkey123

# ─── Frontend ────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

# ─── Queue ───────────────────────────────────────────────────────────────────
QUEUE_ENABLED=false

# ─── Internal Secrets ────────────────────────────────────────────────────────
HABIT_INTERNAL_SECRET=transition-habit-internal-secret
ANALYTICS_INTERNAL_SECRET=transition-analytics-internal-secret
NUDGE_DISPATCH_SECRET=transition-nudge-secret
INTERNAL_EVENT_SECRET=transition-internal-secret
INTERNAL_EVENT_MAX_SKEW_MS=600000

# ─── VAPID (Web Push) ────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=BPcaksYqPqkxBKtYMjp6hcjjkDM3zo0jEl27rmSUFC2xmeO_kPnfCnbtO6Gz_7fx15pG84qlusvOQN8MmlN8dGE
VAPID_PRIVATE_KEY=PgNFIBkQoOTIS6AWPHqpkhmruVDwOkFijpaq_n9x3W0
VAPID_SUBJECT=mailto:admin@example.com

# ─── WhatsApp Outbound ───────────────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v22.0
WHATSAPP_OUTBOUND_URL=
WHATSAPP_OUTBOUND_TOKEN=
WHATSAPP_NUDGE_TEMPLATE_NAME=study_nudge
WHATSAPP_NUDGE_TEMPLATE_LANG=en_US
WHATSAPP_DISPATCH_MAX_RETRIES=3

# ─── WhatsApp Nudge Behaviour ────────────────────────────────────────────────
WHATSAPP_RECENT_ACTIVITY_HOURS=2
WHATSAPP_FALLBACK_DELAY_MS=900000
WHATSAPP_USER_PHONE_MAP=

# ─── WhatsApp Activity / Debounce ────────────────────────────────────────────
WHATSAPP_ACTIVITY_CANCEL_DEBOUNCE_MS=60000

# ─── Nudge Dispatch ──────────────────────────────────────────────────────────
NUDGE_DISPATCH_INTERVAL_MS=60000

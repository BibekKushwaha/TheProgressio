# JWT Secret Key
JWT_SEC=your_jwt_secret_key_here

# Server Port
PORT=4001

# CORS & Auth
FRONTEND_URL=http://localhost:3000

# Redis Config (for BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
QUEUE_ENABLED=true

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# WhatsApp fallback strategy
WHATSAPP_FALLBACK_DELAY_MS=900000
WHATSAPP_RECENT_ACTIVITY_HOURS=2
WHATSAPP_ACTIVITY_CANCEL_DEBOUNCE_MS=60000
WHATSAPP_NUDGE_TEMPLATE_NAME=study_nudge
WHATSAPP_NUDGE_TEMPLATE_LANG=en_US

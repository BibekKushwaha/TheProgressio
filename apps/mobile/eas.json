{
    "cli": {
        "version": ">= 10.0.0",
        "appVersionSource": "local"
    },
    "build": {
        "base": {
            "node": "20.19.0"
        },
        "development": {
            "extends": "base",
            "developmentClient": true,
            "distribution": "internal",
            "ios": {
                "simulator": true
            },
            "env": {
                "EXPO_PUBLIC_API_BASE_URL": "http://localhost:3001",
                "EXPO_PUBLIC_PROJECT_ID": "3a6a45df-e74d-45d7-a184-65e7d0a2b19e",
                "SENTRY_UPLOAD_DIST": "0"
            }
        },
        "preview": {
            "extends": "base",
            "distribution": "internal",
            "channel": "preview",
            "ios": {
                "simulator": false
            },
            "env": {
                "EXPO_PUBLIC_API_BASE_URL": "https://staging-api.theprogressio.com",
                "EXPO_PUBLIC_PROJECT_ID": "3a6a45df-e74d-45d7-a184-65e7d0a2b19e",
                "EXPO_PUBLIC_SENTRY_DSN": "your-sentry-dsn",
                "SENTRY_AUTH_TOKEN": "your-sentry-auth-token",
                "SENTRY_ORG": "theprogressio",
                "SENTRY_PROJECT": "theprogressio-mobile"
            }
        },
        "production": {
            "extends": "base",
            "autoIncrement": true,
            "channel": "production",
            "ios": {
                "buildConfiguration": "Release"
            },
            "android": {
                "buildType": "apk"
            },
            "env": {
                "EXPO_PUBLIC_API_BASE_URL": "https://api.theprogressio.com",
                "EXPO_PUBLIC_PROJECT_ID": "3a6a45df-e74d-45d7-a184-65e7d0a2b19e",
                "EXPO_PUBLIC_SENTRY_DSN": "your-sentry-dsn",
                "EXPO_PUBLIC_APP_VERSION": "1.0.0",
                "SENTRY_AUTH_TOKEN": "your-sentry-auth-token",
                "SENTRY_ORG": "theprogressio",
                "SENTRY_PROJECT": "theprogressio-mobile"
            }
        }
    },
    "submit": {
        "production": {
            "ios": {
                "appleId": "your-apple-id@email.com",
                "ascAppId": "your-app-store-connect-id",
                "appleTeamId": "YOUR_TEAM_ID"
            },
            "android": {
                "serviceAccountKeyPath": "./google-service-account.json",
                "track": "internal"
            }
        }
    }
}
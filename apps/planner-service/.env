# ─── Core ────────────────────────────────────────────────────────────────────
JWT_SEC=secretkey123
PORT=4001
NODE_ENV=development
DATABASE_URL=postgresql://postgres:12345@localhost:5432/transition
# NOTE: docker-compose.yaml uses POSTGRES_PASSWORD=password

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
# Set to "true" to enable BullMQ background job queues
QUEUE_ENABLED=true

# ─── Push notifications (VAPID) ──────────────────────────────────────────────
VAPID_PUBLIC_KEY=BPcaksYqPqkxBKtYMjp6hcjjkDM3zo0jEl27rmSUFC2xmeO_kPnfCnbtO6Gz_7fx15pG84qlusvOQN8MmlN8dGE
VAPID_PRIVATE_KEY=PgNFIBkQoOTIS6AWPHqpkhmruVDwOkFijpaq_n9x3W0
VAPID_SUBJECT=mailto:admin@example.com

# ─── AI / Mistral ────────────────────────────────────────────────────────────
MISTRAL_API_KEY=gTKG4UZp7Z1Q54we7vrE8KqTEF6tTMB6
GEMINI_API_KEY=AIzaSyDXtA0vG7jAj01pjVd97UoDse6BkmW1iww
# Override default models (optional)
MISTRAL_VISION_MODEL=pixtral-12b-2409
MISTRAL_OCR_MODEL=pixtral-large-latest
MISTRAL_VISION_FALLBACK_MODEL=pixtral-large-latest
MISTRAL_VISION_MAX_RETRIES=3
MISTRAL_SCAN_CACHE_TTL_MS=21600000
MISTRAL_SCAN_CACHE_MAX_ENTRIES=200

# ─── AI circuit breaker ──────────────────────────────────────────────────────
# Opens the circuit after this many consecutive failures (default 3)
AI_CB_FAILURE_THRESHOLD=3
# Treat an AI call slower than this as a failure (ms, default 8 s)
AI_CB_LATENCY_THRESHOLD_MS=8000
# How long to keep the circuit open before allowing a probe (ms, default 30 s)
AI_CB_RESET_MS=30000

# ─── Internal service URLs ───────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
ANALYTICS_SERVICE_URL=http://localhost:4003
HABIT_SERVICE_URL=http://localhost:4002

# ─── Internal service secrets ────────────────────────────────────────────────
# Used to authenticate server-to-server calls between planner ↔ habit/analytics
INTERNAL_EVENT_SECRET=transition-internal-secret
ANALYTICS_INTERNAL_SECRET=
HABIT_INTERNAL_SECRET=

# ─── Payments (Razorpay) ─────────────────────────────────────────────────────
RAZORPAY_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# ─── Task side-effects ───────────────────────────────────────────────────────
# Backoff before retrying failed side-effect calls (ms, default 30 s)
SIDE_EFFECT_OUTAGE_BACKOFF_MS=30000

# ─── Recovery / rescheduling ─────────────────────────────────────────────────
RECOVERY_MAX_DAILY_LOAD=6
RECOVERY_MAX_SHIFT_DAYS=45

# ─── WhatsApp — Meta Cloud API ───────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Alias accepted by meta-whatsapp.service.ts (either var works)
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_API_VERSION=v22.0
WHATSAPP_GRAPH_VERSION=v22.0
# Legacy fields kept for backward compatibility
API_VERSION=
PHONE_NUMBER_ID=

# ─── WhatsApp — security ─────────────────────────────────────────────────────
# Secret used in x-whatsapp-secret header to authorise internal capture calls
WHATSAPP_WEBHOOK_SECRET=
# Token that Meta sends during webhook verification handshake
WHATSAPP_VERIFY_TOKEN=
# App secret used to verify Meta HMAC-SHA256 webhook signatures
WHATSAPP_APP_SECRET=

# ─── WhatsApp — inbound rate limiting & abuse detection ──────────────────────
# Max messages per phone per window before hard blocking (default 20 / 60 s)
WHATSAPP_INBOUND_RATE_LIMIT=20
WHATSAPP_INBOUND_RATE_WINDOW_S=60
# Number of bad signals before a phone is blocked (default 8 in 120 s)
WHATSAPP_ABUSE_THRESHOLD=8
WHATSAPP_ABUSE_WINDOW_S=120
# How long the abuse block lasts in seconds (default 1 h)
WHATSAPP_ABUSE_BLOCK_S=3600
# Max age of a webhook timestamp before it is treated as a replay attack (s)
WHATSAPP_TIMESTAMP_MAX_AGE_S=300
# Debounce window for cancelling duplicate activity triggers (ms, default 60 s)
WHATSAPP_ACTIVITY_CANCEL_DEBOUNCE_MS=60000

# ─── WhatsApp — optional services ────────────────────────────────────────────
# URL of a voice-transcription sidecar (leave blank to skip transcription)
WHATSAPP_TRANSCRIBE_URL=
# URL of an OCR sidecar (leave blank to skip image text extraction)
WHATSAPP_OCR_URL=
# JSON map of phone → userId for static number resolution (optional)
# Example: {"911234567890":"user-id-1"}
WHATSAPP_NUMBER_USER_MAP=
# URL shown to users when they click the premium upgrade button
WHATSAPP_PREMIUM_UPGRADE_URL=https://your-app.example.com/pricing

# ─── WhatsApp — parent watch / silent monitoring ─────────────────────────────
# Set to "true" to enable the cron-based silent-watch sweep
WHATSAPP_SILENT_WATCH_CRON_ENABLED=false
WHATSAPP_SILENT_WATCH_INTERVAL_MINUTES=60
# Max overdue tasks before a parent alert is sent (default 5)
WHATSAPP_PARENT_OVERDUE_THRESHOLD=5
# Min completion % to avoid a consistency alert (default 50)
WHATSAPP_PARENT_CONSISTENCY_THRESHOLD=50
# JSON map of studentUserId → parentWhatsAppNumber for parent watch feature
# Example: {"student-id-1":"919876543210"}
WHATSAPP_PARENT_WATCH_MAP=

# ─── Observability / alerting ────────────────────────────────────────────────
# Sliding window for latency percentile computation (ms, default 10 min)
WA_LATENCY_WINDOW_MS=600000
# How long to suppress repeat alerts for the same metric (s, default 5 min)
WA_ALERT_COOLDOWN_S=300
# Alert thresholds (fractions 0–1)
WA_ALERT_ERROR_RATE=0.05
WA_ALERT_ABUSE_RATE=0.20
WA_ALERT_OUTBOUND_FAIL_RATE=0.10
# Alert if any intent's p95 latency exceeds this (ms, default 10 s)
WA_ALERT_LATENCY_P95_MS=10000

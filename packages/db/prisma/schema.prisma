// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String     @id @default(uuid())
  username         String     @unique
  email            String     @unique
  password         String
  whatsappNumber   String?    @unique
  whatsappVerified Boolean    @default(false)
  whatsappPairingCode String? @unique
  lastActiveAt     DateTime?
  // Account lockout: incremented on each failed login, reset on success.
  // lockedUntil is set when failedLoginAttempts reaches the threshold.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  dailyGoalHours   Float      @default(4.0)
  plan             BillingPlan   @default(FREE)
  planStatus       BillingStatus @default(INACTIVE)
  renewalAt        DateTime?
  paymentProvider  String?
  paymentRef       String?
  // Role-based access control
  role             String        @default("USER")  // "USER" | "ADMIN"
  createdAt        DateTime   @default(now())
  
  // XP / Gamification
  xp               Int        @default(0)
  level            Int        @default(1)
  
  // Relationships with Cascade - Deleting user wipes all their data
  categories       Category[]
  tasks            Task[]
  habits           Habit[]
  taskCompletionStats TaskCompletionStat[]
  achievements     UserAchievement[]
  nudges           Nudge[]
  gradeEntries     GradeEntry[]
  courseGrades      CourseGrade[]
  paymentEvents    PaymentEvent[]
  syncOperations   SyncOperation[]
  attendance       Attendance[]
  
  // Academic Relations
  subjects         Subject[]
  exams            Exam[]
  studyGoals       StudyGoal[]
  timetable        Timetable[]
  rotationPatterns RotationPattern[]
  holidays         SchoolHoliday[]
  
  mobileRefreshTokens  MobileRefreshToken[]
  passwordResetTokens  PasswordResetToken[]
  securityEvents       SecurityEvent[]
  oauthAccounts        OAuthAccount[]
  familyShareLinks    FamilyShareLink[]
  syllabusTopics          SyllabusTopic[]
  syllabusEdges           SyllabusEdge[]
  taskSyllabusTopics      TaskSyllabusTopic[]
  notes               Note[]
  auditLogs           AuditLog[]
  pushSubscriptions   WebPushSubscription[]
  conversations       UserConversation[]
  // Fraud
  fraudRisk            String      @default("NONE")  // "NONE" | "LOW" | "MEDIUM" | "HIGH" | "BLOCKED"
  fraudFlags           FraudFlag[]
}

model OAuthAccount {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String
  providerAccountId String
  email             String?
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model WebPushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model UserConversation {
  id              String   @id @default(uuid())
  userId          String
  category        String
  windowStartedAt DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@index([category, windowStartedAt])
}

model MobileRefreshToken {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash         String    @unique
  deviceId          String?
  expiresAt         DateTime
  // Hard cap: no matter how many times the token is rotated, this session
  // must end by absoluteExpiresAt. Prevents infinite sliding sessions.
  // Nullable for backwards compat with existing rows (treated as uncapped).
  absoluteExpiresAt DateTime?
  revokedAt         DateTime?
  // Device fingerprint fields (stored as short hashes, not raw values)
  deviceName        String?   // Human-readable: "Chrome on macOS"
  ipHash            String?   // SHA-256 prefix of client IP
  uaHash            String?   // SHA-256 prefix of user-agent
  lastSeenAt        DateTime? // Updated on each successful refresh
  createdAt         DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
}

// Tracks issued password-reset tokens so they can be single-use and revocable.
// Storing the hash (not the raw token) so a DB breach doesn't expose live tokens.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
}

// Immutable security event log. Used for auditing, attack investigation,
// and triggering security alerts. Never updated — only inserted.
model SecurityEvent {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  eventType String   // LOGIN_SUCCESS | LOGIN_FAILED | ACCOUNT_LOCKED |
                     // REFRESH_TOKEN_REUSE | SUSPICIOUS_SESSION |
                     // PASSWORD_RESET_REQUESTED | PASSWORD_CHANGED |
                     // SESSION_REVOKED | LOGOUT_ALL_DEVICES
  ipHash    String?  // SHA-256 prefix of client IP
  uaHash    String?  // SHA-256 prefix of user-agent
  details   String?  // JSON string for extra context
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
  @@index([createdAt])
}

model FamilyShareLink {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String   @unique
  label       String?
  permissions String   @default("READ_ONLY") // READ_ONLY, FULL_ACCESS
  expiresAt   DateTime?
  revokedAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([tokenHash])
}


model SyllabusTopic {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId     String
  category       Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  chapter        String
  title          String
  notes          String?
  weight         Float?
  estimatedHours Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  prerequisites  SyllabusEdge[] @relation("SyllabusEdgeTo")
  unlocks        SyllabusEdge[] @relation("SyllabusEdgeFrom")
  taskLinks      TaskSyllabusTopic[]

  @@unique([userId, categoryId, chapter, title])
  @@index([userId, categoryId])
}

model SyllabusEdge {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromTopicId String
  toTopicId   String
  fromTopic   SyllabusTopic @relation("SyllabusEdgeFrom", fields: [fromTopicId], references: [id], onDelete: Cascade)
  toTopic     SyllabusTopic @relation("SyllabusEdgeTo", fields: [toTopicId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([userId, fromTopicId, toTopicId])
  @@index([userId, toTopicId])
}

model TaskSyllabusTopic {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  topicId   String
  topic     SyllabusTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([taskId, topicId])
  @@index([userId, topicId])
  @@index([userId, taskId])
}

model Achievement {
  id          String   @id @default(uuid())
  key         String   @unique // e.g., "FIRST_TASK", "STREAK_7"
  name        String
  description String
  icon        String   // Lucide icon name or emoji
  type        String   // "STREAK", "TASK", "FOCUS"
  goalValue   Int
  createdAt   DateTime @default(now())
  
  users       UserAchievement[]
}

model SchoolHoliday {
  id                 String   @id @default(uuid())
  name               String
  startDate          DateTime
  endDate            DateTime
  pauseNotifications Boolean  @default(true)
  
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId, startDate])
  @@index([userId, endDate])
}

model UserAchievement {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  unlockedAt    DateTime @default(now())

  @@unique([userId, achievementId])
}

model Category {
  id           String   @id @default(uuid())
  name         String
  colorCode    String   @default("#3B82F6")
  icon         String?  // Lucide icon name e.g. "Calculator", "Beaker", "BookOpen"
  syncLamportTs Int     @default(0)
  syncVectorClock String?
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks        Task[]
  syllabusTopics SyllabusTopic[]

  @@unique([userId, name])
}

model Task {
  id           String     @id @default(uuid())
  title        String
  status       Status     @default(PENDING)
  priority     Priority   @default(MEDIUM)
  dueDate      DateTime?
  isRecurring  Boolean    @default(false)
  effort       Effort?
  
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  categoryId   String?
  category     Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  
  subjectId    String?
  subject      Subject?   @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  
  description  String?
  syncLamportTs Int       @default(0)
  syncVectorClock String?
  subtasks     SubTask[]
  attachments  Attachment[]

  activityLogs ActivityLog[]
  reminders    Reminder[]
  taskCompletionStat TaskCompletionStat?
  syllabusLinks TaskSyllabusTopic[]

  // Composite index for the most common analytics filter patterns
  @@index([userId, status, dueDate])  // overdue / upcoming task queries
  @@index([userId, status])           // count by status queries
  @@index([userId, dueDate])          // date-range task fetches
}

model Attachment {
  id        String   @id @default(uuid())
  name      String
  url       String
  size      String?
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model SubTask {
  id        String   @id @default(uuid())
  title     String
  completed Boolean  @default(false)
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Habit {
  id            String    @id @default(uuid())
  name          String
  frequency     Frequency @default(DAILY)
  targetValue   Int       @default(1) 
  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  icon          String?
  color         String?
  lastLogDate   DateTime? 

  // Optional schedule (local wall-clock time)
  reminderTime  String?   // HH:mm
  scheduleHint  String?   // morning|afternoon|evening|night
  
  // Gentle Streak settings
  mercyDaysAllowed Int     @default(1)   // how many skips before streak breaks
  mercyDaysUsed    Int     @default(0)   // skips used in current streak
  
  // Auto-link: category name match -> auto-log on task completion
  linkedCategoryId String?
  
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  logs          HabitLog[]
  reminders     Reminder[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model HabitLog {
  id             String   @id @default(uuid())
  habitId        String
  habit          Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  completedValue Int      @default(1)
  loggedAt       DateTime @default(now())

  @@index([habitId, loggedAt])
}

model ActivityLog {
  id              String      @id @default(uuid())
  startTime       DateTime    @default(now())
  endTime         DateTime?
  durationMinutes Int?        
  sessionType     SessionType @default(DEEP_WORK)
  
  taskId          String
  task            Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // Composite index: analytics queries always filter by task.userId + startTime range.
  // Since ActivityLog→Task is a join, index on (taskId, startTime) covers both.
  @@index([taskId, startTime])
  @@index([startTime])  // Supports range scans for admin/monitoring queries
}

model TaskCompletionStat {
  id            String   @id @default(uuid())
  taskId        String   @unique
  task          Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalMinutes  Int
  completedAt   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, completedAt])
}

model Reminder {
  id           String   @id @default(uuid())
  reminderTime DateTime
  isSent       Boolean  @default(false)
  
  taskId       String?
  task         Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  
  habitId      String?
  habit        Habit?   @relation(fields: [habitId], references: [id], onDelete: Cascade)
}

// --- Enums for better Data Integrity ---

enum Status {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum Effort {
  M30
  H1
  H2
  H4_PLUS
}

enum Frequency {
  DAILY
  WEEKLY
}

enum SessionType {
  DEEP_WORK
  POMODORO
  BREAK
}

model Subject {
  id          String   @id @default(uuid())
  name        String
  code        String?  // e.g., "MATH101"
  teacher     String?
  room        String?
  color       String   @default("#3B82F6")
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  tasks       Task[]
  exams       Exam[]
  goals       StudyGoal[]
  timetable   Timetable[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, name])
}

model Exam {
  id          String   @id @default(uuid())
  title       String
  date        DateTime
  durationMinutes Int
  location    String?
  topics      String?  // simple detailed text for now
  priority    Priority @default(HIGH)
  
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model StudyGoal {
  id          String   @id @default(uuid())
  title       String
  targetDate  DateTime?
  isAchieved  Boolean  @default(false)
  
  subjectId   String?
  subject     Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Timetable {
  id          String   @id @default(uuid())
  dayOfWeek   Int      // 0-6 (Sun-Sat) or 1-5 (Mon-Fri)
  startTime   String   // "09:00"
  endTime     String   // "10:30"
  
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // For rotation support (e.g., Week A/B)
  rotation    String?  // "A", "B", "1", "2" etc.

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Custom rotation pattern — allows users to define their own rotation calendar
model RotationPattern {
  id            String   @id @default(uuid())
  name          String   // e.g., "Week A/B", "Day 1-4 Block"
  pattern       String[] // ordered cycle labels e.g. ["A","B"] or ["1","2","3","4"]
  startDate     DateTime // anchor date: the first day of the rotation
  cycleLengthDays Int    @default(7) // how many days each label lasts (7 = weekly rotation)
  
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, name])
}

// ── Phase 2: Nudge System ──────────────────────────────────────────────

model Nudge {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type        String    // "STREAK_RISK", "EXAM_WARNING", "MORNING_BRIEFING", "SLIP_DETECTION"
  title       String
  message     String
  priority    Priority  @default(MEDIUM)
  isRead      Boolean   @default(false)
  scheduledAt DateTime  @default(now())
  deliveredAt DateTime?
  expiresAt   DateTime?
  localDate   String?   // YYYY-MM-DD in user's local timezone
  idempotencyKey String?
  skippedReason String?
  metadata    String?   // JSON string for extra context
  
  createdAt   DateTime  @default(now())
  
  @@index([userId, isRead])
  @@index([userId, scheduledAt])
  @@unique([idempotencyKey])
  @@unique([userId, localDate, type])
}

// ── Phase 3: GPA / Grade Tracking ──────────────────────────────────────

model CourseGrade {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  courseName  String
  credits     Float    @default(3)
  gradePoint  Float?   // e.g., 9.0 on a 10-point scale
  grade       String?  // e.g., "A", "B+", "O"
  semester    Int      @default(1)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([userId, semester])
}

model GradeEntry {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  subjectName   String
  chapter       String?
  totalMarks    Float
  obtainedMarks Float
  examType      String   // "JEE", "NEET", "UPSC", "INTERNAL", "BOARD"
  timeTakenMins Int?     // time taken per question/section
  
  createdAt     DateTime @default(now())

  // Covering index for groupBy(userId, examType, subjectName, chapter) used by SWOT aggregation.
  // Replaces the two narrow indexes — the query planner will use this for both the
  // userId+examType filter and the userId+subjectName filter (left-prefix rule).
  @@index([userId, examType, subjectName, chapter])
}

// ── Phase 4: Payments ──────────────────────────────────────────────────

model PaymentEvent {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  intentId        String   @unique
  paymentRef      String   @unique
  provider        String   // "UPI" | "NET_BANKING" | "CARD" | "WALLET"
  plan            BillingPlan
  amountPaise     Int
  status          String   // "CREATED" | "PENDING" | "SUCCESS" | "FAILED" | "REFUNDED"
  eventType       String   @default("PAYMENT")  // "PAYMENT" | "RENEWAL" | "REFUND" | "UPGRADE"
  upiId           String?
  payload         String?  // JSON metadata / webhook payload
  // Refund tracking
  refundId        String?  // Razorpay refund ID (rfnd_xxxx)
  refundedAt      DateTime?
  refundAmountPaise Int?   // may be partial
  // Retry tracking (for failed payments)
  retryCount      Int      @default(0)  // 0 = original, 1/2/3 = retry attempts
  parentRef       String?  // paymentRef of the original event this is retrying
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([parentRef])
}

model SyncOperation {
  id          Int      @id @default(autoincrement())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId    String
  opId        String
  entityType  String   // "task" | "category"
  entityId    String
  action      String   // "UPSERT" | "DELETE"
  payload     String?  // JSON payload
  lamportTs   Int
  vectorClock String?  // JSON object string
  tombstone   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([userId, opId])
  @@index([userId, id])
  @@index([userId, entityType, entityId, lamportTs])
}

enum BillingPlan {
  FREE
  PRO
  INSTITUTION
}

enum BillingStatus {
  INACTIVE
  ACTIVE
  PAST_DUE
  CANCELED
}

model Attendance {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime         @default(now())
  status    AttendanceStatus @default(PRESENT)
  method    AttendanceMethod @default(QR)
  location  String?
  createdAt DateTime         @default(now())

  @@index([userId, date])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum AttendanceMethod {
  QR
  MANUAL
  GEOFENCE
}

// ── Phase 5: Notes & Audit Trails ────────────────────────────────────────

model Note {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action     String   // e.g., "TASK_COMPLETED", "HABIT_LOGGED", "ATTENDANCE_MARKED"
  entityType String   // e.g., "TASK", "HABIT", "ATTENDANCE"
  entityId   String
  details    String?  // JSON string containing extra details
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}

// ── 50K-Scale: Pre-Aggregated Daily User Stats ─────────────────────────
//
// Updated on every task-completion/activity-log write event (via the BullMQ
// analytics worker).  Analytics overview endpoints read from this table
// instead of running expensive live aggregations over millions of rows.
// Result: analytical reads become O(1) lookups instead of full table scans.
//
model DailyUserStats {
  id                String   @id @default(uuid())
  userId            String
  date              DateTime // Truncated to midnight UTC — one row per user per day
  
  // Task metrics
  completedTasks    Int      @default(0)
  totalTasks        Int      @default(0)
  overdueTasks      Int      @default(0)
  
  // Focus metrics
  focusMinutes      Int      @default(0)   // Total activity log minutes
  deepWorkMinutes   Int      @default(0)   // SESSION_TYPE = DEEP_WORK
  sessionCount      Int      @default(0)   // Number of activity log sessions
  
  // Grade/academic metrics  
  avgScore          Float?                 // Average grade entry score (0-100)
  gradeEntryCount   Int      @default(0)
  
  // Aggregation metadata
  lastUpdatedAt     DateTime @default(now()) @updatedAt
  createdAt         DateTime @default(now())

  @@unique([userId, date])                 // One row per (user × day)
  @@index([userId, date])                  // Hot lookup path for analytics overview
}

// ── WhatsApp Replay / Idempotency Protection ─────────────────────────────
//
// Every inbound Meta webhook message carries a unique wamid. We record it
// here immediately on first receipt so that:
//   • Duplicate deliveries from Meta are silently acknowledged (idempotency).
//   • Replayed old messages (stale timestamp) are rejected before any DB write.
//
// Rows are cheap: only the wamid string + a timestamp. A periodic job (or a
// Prisma cron) can delete rows older than 24 h to keep the table small.
//
model ProcessedWhatsAppMessage {
  messageId   String   @id          // wamid from Meta Cloud API (e.g. "wamid.xxx")
  processedAt DateTime @default(now())

  @@index([processedAt])
}

// ── 50K-Scale: Async Export Job Tracking ─────────────────────────────────
//
// PDF / CSV exports are queued as background jobs so the main API thread is
// never blocked by file generation (which can consume 3 MB+ memory per job).
// Clients poll this record or receive a webhook / SSE event on completion.
//
model ExportJob {
  id          String   @id @default(uuid())
  userId      String
  type        String   // "PDF_REPORT" | "CSV_TASKS" | "CSV_GRADES"
  status      String   @default("PENDING") // "PENDING" | "PROCESSING" | "DONE" | "FAILED"
  params      String?  // JSON: export parameters (date range, format, etc.)
  fileUrl     String?  // Signed URL to the generated file (set on completion)
  errorMsg    String?  // Set on failure
  expiresAt   DateTime?                    // File URL expiry
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, status, createdAt])
  @@index([userId, createdAt])
}

// ── Fraud Detection ──────────────────────────────────────────────────────────

model FraudFlag {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   // "VELOCITY" | "DUPLICATE_INSTRUMENT" | "CROSS_ACCOUNT" | "SUSPICIOUS_AMOUNT" | "RAPID_PLAN_SWITCH"
  risk        String   // "LOW" | "MEDIUM" | "HIGH" | "CRITICAL"
  details     String?  // JSON: contextual evidence
  paymentRef  String?  // Linked PaymentEvent.paymentRef (if applicable)
  resolved    Boolean  @default(false)
  resolvedAt  DateTime?
  resolvedBy  String?  // admin user ID
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([type, risk, resolved])
  @@index([resolved, createdAt])
}

// ── Webhook Dead-Letter Queue ────────────────────────────────────────────────

model WebhookDLQ {
  id          String   @id @default(uuid())
  event       String   // Razorpay event type e.g. "payment.captured"
  rawBody     String   // Full raw webhook body
  signature   String?  // X-Razorpay-Signature header value
  reason      String   // Why processing failed
  retryCount  Int      @default(0)
  nextRetryAt DateTime?
  resolved    Boolean  @default(false)
  resolvedAt  DateTime?
  resolvedBy  String?  // admin user ID
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([event, resolved])
  @@index([resolved, nextRetryAt])
  @@index([createdAt])
}

// ── Razorpay Reconciliation Reports ─────────────────────────────────────────

model ReconciliationReport {
  id                  String   @id @default(uuid())
  reportDate          DateTime // The settlement date being reconciled
  status              String   @default("PENDING")  // "PENDING" | "RUNNING" | "COMPLETED" | "FAILED"
  // Counts
  rzpTotalCount       Int      @default(0)  // Payments found in Razorpay
  dbTotalCount        Int      @default(0)  // PaymentEvent SUCCESS rows for that date
  matchedCount        Int      @default(0)
  // Discrepancies (stored as JSON arrays)
  missingInDb         String?  // JSON: payment IDs captured in Razorpay but absent in DB
  missingInRzp        String?  // JSON: DB SUCCESS paymentRefs not found in Razorpay
  amountMismatches    String?  // JSON: {paymentRef, dbAmount, rzpAmount}[]
  // Revenue snapshot for the date
  totalRevenuePaise   Int      @default(0)
  refundedPaise       Int      @default(0)
  netRevenuePaise     Int      @default(0)
  errorMsg            String?
  runAt               DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([reportDate])
  @@index([status, reportDate])
}

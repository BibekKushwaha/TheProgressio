// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql" 
}

model User {
  id               String     @id @default(uuid())
  username         String     @unique
  email            String     @unique
  password         String
  dailyGoalHours   Float      @default(4.0)
  createdAt        DateTime   @default(now())
  
  // Relationships with Cascade - Deleting user wipes all their data
  categories       Category[]
  tasks            Task[]
  habits           Habit[]
  taskCompletionStats TaskCompletionStat[]
}

model Category {
  id           String   @id @default(uuid())
  name         String
  colorCode    String   @default("#3B82F6")
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks        Task[]

  @@unique([userId, name])
}

model Task {
  id           String     @id @default(uuid())
  title        String
  status       Status     @default(PENDING)
  priority     Priority   @default(MEDIUM)
  dueDate      DateTime?
  isRecurring  Boolean    @default(false)
  
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  categoryId   String?
  category     Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  
  description  String?
  subtasks     SubTask[]
  attachments  Attachment[]

  activityLogs ActivityLog[]
  reminders    Reminder[]
  taskCompletionStat TaskCompletionStat?
}

model Attachment {
  id        String   @id @default(uuid())
  name      String
  url       String
  size      String?
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model SubTask {
  id        String   @id @default(uuid())
  title     String
  completed Boolean  @default(false)
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Habit {
  id            String    @id @default(uuid())
  name          String
  frequency     Frequency @default(DAILY)
  targetValue   Int       @default(1) 
  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  icon          String?
  color         String?
  lastLogDate   DateTime? 
  
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  logs          HabitLog[]
  reminders     Reminder[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model HabitLog {
  id             String   @id @default(uuid())
  habitId        String
  habit          Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  completedValue Int      @default(1)
  loggedAt       DateTime @default(now())

  @@index([habitId, loggedAt])
}

model ActivityLog {
  id              String      @id @default(uuid())
  startTime       DateTime    @default(now())
  endTime         DateTime?
  durationMinutes Int?        
  sessionType     SessionType @default(DEEP_WORK)
  
  taskId          String
  task            Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model TaskCompletionStat {
  id            String   @id @default(uuid())
  taskId        String   @unique
  task          Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalMinutes  Int
  completedAt   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, completedAt])
}

model Reminder {
  id           String   @id @default(uuid())
  reminderTime DateTime
  isSent       Boolean  @default(false)
  
  taskId       String?
  task         Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  
  habitId      String?
  habit        Habit?   @relation(fields: [habitId], references: [id], onDelete: Cascade)
}

// --- Enums for better Data Integrity ---

enum Status {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum Frequency {
  DAILY
  WEEKLY
}

enum SessionType {
  DEEP_WORK
  POMODORO
  BREAK
}

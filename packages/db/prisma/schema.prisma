// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql" 
}

model User {
  id               String     @id @default(uuid())
  username         String     @unique
  email            String     @unique
  password         String
  dailyGoalHours   Float      @default(4.0)
  createdAt        DateTime   @default(now())
  
  // XP / Gamification
  xp               Int        @default(0)
  level            Int        @default(1)
  
  // Relationships with Cascade - Deleting user wipes all their data
  categories       Category[]
  tasks            Task[]
  habits           Habit[]
  taskCompletionStats TaskCompletionStat[]
  achievements     UserAchievement[]
  nudges           Nudge[]
  gradeEntries     GradeEntry[]
  courseGrades      CourseGrade[]
  
  // Academic Relations
  subjects         Subject[]
  exams            Exam[]
  studyGoals       StudyGoal[]
  timetable        Timetable[]
  rotationPatterns RotationPattern[]
}

model Achievement {
  id          String   @id @default(uuid())
  key         String   @unique // e.g., "FIRST_TASK", "STREAK_7"
  name        String
  description String
  icon        String   // Lucide icon name or emoji
  type        String   // "STREAK", "TASK", "FOCUS"
  goalValue   Int
  createdAt   DateTime @default(now())
  
  users       UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  unlockedAt    DateTime @default(now())

  @@unique([userId, achievementId])
}

model Category {
  id           String   @id @default(uuid())
  name         String
  colorCode    String   @default("#3B82F6")
  icon         String?  // Lucide icon name e.g. "Calculator", "Beaker", "BookOpen"
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks        Task[]

  @@unique([userId, name])
}

model Task {
  id           String     @id @default(uuid())
  title        String
  status       Status     @default(PENDING)
  priority     Priority   @default(MEDIUM)
  dueDate      DateTime?
  isRecurring  Boolean    @default(false)
  
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  categoryId   String?
  category     Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  
  subjectId    String?
  subject      Subject?   @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  
  description  String?
  subtasks     SubTask[]
  attachments  Attachment[]

  activityLogs ActivityLog[]
  reminders    Reminder[]
  taskCompletionStat TaskCompletionStat?
}

model Attachment {
  id        String   @id @default(uuid())
  name      String
  url       String
  size      String?
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model SubTask {
  id        String   @id @default(uuid())
  title     String
  completed Boolean  @default(false)
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Habit {
  id            String    @id @default(uuid())
  name          String
  frequency     Frequency @default(DAILY)
  targetValue   Int       @default(1) 
  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  icon          String?
  color         String?
  lastLogDate   DateTime? 
  
  // Gentle Streak settings
  mercyDaysAllowed Int     @default(1)   // how many skips before streak breaks
  mercyDaysUsed    Int     @default(0)   // skips used in current streak
  
  // Auto-link: category name match -> auto-log on task completion
  linkedCategoryId String?
  
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  logs          HabitLog[]
  reminders     Reminder[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model HabitLog {
  id             String   @id @default(uuid())
  habitId        String
  habit          Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  completedValue Int      @default(1)
  loggedAt       DateTime @default(now())

  @@index([habitId, loggedAt])
}

model ActivityLog {
  id              String      @id @default(uuid())
  startTime       DateTime    @default(now())
  endTime         DateTime?
  durationMinutes Int?        
  sessionType     SessionType @default(DEEP_WORK)
  
  taskId          String
  task            Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model TaskCompletionStat {
  id            String   @id @default(uuid())
  taskId        String   @unique
  task          Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalMinutes  Int
  completedAt   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, completedAt])
}

model Reminder {
  id           String   @id @default(uuid())
  reminderTime DateTime
  isSent       Boolean  @default(false)
  
  taskId       String?
  task         Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  
  habitId      String?
  habit        Habit?   @relation(fields: [habitId], references: [id], onDelete: Cascade)
}

// --- Enums for better Data Integrity ---

enum Status {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum Frequency {
  DAILY
  WEEKLY
}

enum SessionType {
  DEEP_WORK
  POMODORO
  BREAK
}

model Subject {
  id          String   @id @default(uuid())
  name        String
  code        String?  // e.g., "MATH101"
  teacher     String?
  room        String?
  color       String   @default("#3B82F6")
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  tasks       Task[]
  exams       Exam[]
  goals       StudyGoal[]
  timetable   Timetable[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, name])
}

model Exam {
  id          String   @id @default(uuid())
  title       String
  date        DateTime
  durationMinutes Int
  location    String?
  topics      String?  // simple detailed text for now
  priority    Priority @default(HIGH)
  
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model StudyGoal {
  id          String   @id @default(uuid())
  title       String
  targetDate  DateTime?
  isAchieved  Boolean  @default(false)
  
  subjectId   String?
  subject     Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Timetable {
  id          String   @id @default(uuid())
  dayOfWeek   Int      // 0-6 (Sun-Sat) or 1-5 (Mon-Fri)
  startTime   String   // "09:00"
  endTime     String   // "10:30"
  
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // For rotation support (e.g., Week A/B)
  rotation    String?  // "A", "B", "1", "2" etc.

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Custom rotation pattern — allows users to define their own rotation calendar
model RotationPattern {
  id            String   @id @default(uuid())
  name          String   // e.g., "Week A/B", "Day 1-4 Block"
  pattern       String[] // ordered cycle labels e.g. ["A","B"] or ["1","2","3","4"]
  startDate     DateTime // anchor date: the first day of the rotation
  cycleLengthDays Int    @default(7) // how many days each label lasts (7 = weekly rotation)
  
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, name])
}

// ── Phase 2: Nudge System ──────────────────────────────────────────────

model Nudge {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type        String    // "STREAK_RISK", "EXAM_WARNING", "MORNING_BRIEFING", "SLIP_DETECTION"
  title       String
  message     String
  priority    Priority  @default(MEDIUM)
  isRead      Boolean   @default(false)
  scheduledAt DateTime  @default(now())
  expiresAt   DateTime?
  metadata    String?   // JSON string for extra context
  
  createdAt   DateTime  @default(now())
  
  @@index([userId, isRead])
  @@index([userId, scheduledAt])
}

// ── Phase 3: GPA / Grade Tracking ──────────────────────────────────────

model CourseGrade {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  courseName  String
  credits     Float    @default(3)
  gradePoint  Float?   // e.g., 9.0 on a 10-point scale
  grade       String?  // e.g., "A", "B+", "O"
  semester    Int      @default(1)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([userId, semester])
}

model GradeEntry {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  subjectName   String
  chapter       String?
  totalMarks    Float
  obtainedMarks Float
  examType      String   // "JEE", "NEET", "UPSC", "INTERNAL", "BOARD"
  timeTakenMins Int?     // time taken per question/section
  
  createdAt     DateTime @default(now())
  
  @@index([userId, subjectName])
  @@index([userId, examType])
}

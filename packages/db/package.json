{
  "name": "@repo/db",
  "version": "1.0.0",
  "description": "",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "scripts": {
    "test": "echo 'No tests'",
    "build": "tsc && mkdir -p ./dist/generated && cp -r ./generated/* ./dist/generated/ && find ./dist -name '*.ts' ! -name '*.d.ts' -delete",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "generate": "prisma generate --schema=./prisma/schema.prisma"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "@types/pg": "^8.16.0",
    "pg": "^8.18.0",
    "prisma": "^7.3.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  }
}
